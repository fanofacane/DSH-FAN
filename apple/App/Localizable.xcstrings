    "Agent presets": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 预设"
          }
        }
      }
    },
    "Alarms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟"
          }
        }
      }
    },
    "Alerts contain no message text, tool arguments or credentials.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知不包含对话内容、工具参数或凭据。"
          }
        }
      }
    },
    "Allow %@?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用 %@？"
          }
        }
      }
    },
    "Allow DSH to add photos in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中允许 DSH 添加照片。"
          }
        }
      }
    },
    "Allow for this task": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本任务内允许"
          }
        }
      }
    },
    "Allow microphone and speech recognition for DSH in Settings to dictate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置里允许 DSH 使用麦克风和语音识别后才能语音输入。"
          }
        }
      }
    },
    "Allow once": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许本次"
          }
        }
      }
    },
    "Allow this action?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许这个操作吗？"
          }
        }
      }
    },
    "Allow this command to run?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许运行这条命令？"
          }
        }
      }
    },
    "Allow within a task": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一任务内只问一次"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "Allowed shortcuts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许运行的快捷指令"
          }
        }
      }
    },
    "An AI agent on your iPhone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装在 iPhone 里的 AI 智能体"
          }
        }
      }
    },
    "Anytime, anywhere. Just go!": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时随地，想go就Go！"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Applies to body text and code. Navigation controls keep their standard size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整正文和代码字号，导航控件保持标准大小。"
          }
        }
      }
    },
    "Apply to draft": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用到草稿"
          }
        }
