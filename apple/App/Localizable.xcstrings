      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止并归档"
          }
        }
      }
    },
    "Archive this chat?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档此对话？"
          }
        }
      }
    },
    "Archived chats": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档"
          }
        }
      }
    },
    "Archived chats can be restored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档的对话可以恢复。"
          }
        }
      }
    },
    "Ask DSH": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问 DSH"
          }
        }
      }
    },
    "Ask DSH to create a task": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 DSH 创建任务"
          }
        }
      }
    },
    "Ask anything. The model runs through the engine on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随便问点什么。模型请求由这台 iPhone 上的引擎发出。"
          }
        }
      }
    },
    "Ask every time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次都询问"
          }
        }
      }
    },
    "Asks on first use": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次使用时询问"
          }
        }
      }
    },
    "Authorize in Safari. The engine receives the callback at 127.0.0.1 and stores the account grant.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Safari 中授权。引擎通过 127.0.0.1 接收回调并保存账号授权。"
          }
        }
      }
    },
