        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮到你了"
          }
        }
      }
    },
    "You’ll be asked to check the fingerprint on first connection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接时会请你核对指纹"
          }
        }
      }
    },
    "You’re a night owl too?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你也是夜猫子呀"
          }
        }
      }
