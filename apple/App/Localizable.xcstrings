      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拨号、短信、分享、读取剪贴板，以及每个快捷指令的首次运行，始终会询问。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
