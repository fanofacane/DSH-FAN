    "Chats and settings inside the engine are removed. The runtime is installed again from the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎里的对话和设置都会被删除，运行环境会从 App 重新安装。"
          }
        }
      }
    },
    "Check what files and projects are in the workspace and give me a brief overview.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看工作区里现在有哪些文件和项目，简单介绍一下。"
          }
        }
      }
    },
    "Choose a folder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择目录"
          }
        }
      }
    },
    "Choose notification, photo, microphone and speech permissions in iOS Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS 设置中管理通知、照片、麦克风与语音识别权限。"
          }
