        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这里分叉"
          }
        }
      }
    },
    "Bring a DeepSeek API key. It stays on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的 DeepSeek API Key，它只保存在这台设备上。"
          }
