{
  "sourceLanguage": "en",
  "strings": {
    "%@ keys aren’t supported yet. Use an Ed25519 or ECDSA key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持 %@ 私钥，请使用 Ed25519 或 ECDSA 私钥"
          }
        }
      }
    },
    "%@:%@ isn’t responding": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ 没有响应"
          }
        }
      }
    },
    "%@:%@ refused the connection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ 拒绝了连接"
          }
        }
      }
    },
    "%lld image(s)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张图片"
          }
        }
      }
    },
    "%lld lines": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 行"
          }
        }
      }
    },
    "192.168.1.20 or example.com": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "192.168.1.20 或 example.com"
          }
        }
      }
    },
    "A remote host can keep working, but a suspended iOS app cannot receive new events or issue completion alerts. DSH does not provide server push notifications.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程主机可继续工作，但 iOS App 被挂起后无法接收新事件或发出完成通知。DSH 不提供服务端推送通知。"
          }
        }
      }
    },
    "AI": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        }
      }
    },
    "API base URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 基础地址"
