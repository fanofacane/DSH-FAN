AdvSIMD single-structure LDn/STn: the 16-bit lane index is Q:S:size<1>, not size<0>.
Odd H lanes ([1],[3],[5],[7]) were accessed as the even lane below them, which broke
the mozjpeg NEON IDCT (vst4_lane_s16). Verified on all 1,632 single-structure encodings.

diff --git a/asbestos/guest-arm64/gen.c b/asbestos/guest-arm64/gen.c
--- a/asbestos/guest-arm64/gen.c
+++ b/asbestos/guest-arm64/gen.c
@@ -3483,7 +3483,7 @@ static int gen_ldst(struct gen_state *state, uint32_t insn) {
             lane = (Q << 3) | (S << 2) | size;
         } else if (base_opcode == 2) {
             elem_size = 2;
-            lane = (Q << 2) | (S << 1) | (size & 1);
+            lane = (Q << 2) | (S << 1) | ((size >> 1) & 1);  // H lane = Q:S:size<1>
         } else if (base_opcode == 4 && size == 0) {
             elem_size = 4;
             lane = (Q << 1) | S;
@@ -3590,7 +3590,7 @@ static int gen_ldst(struct gen_state *state, uint32_t insn) {
