             elem_size = 2;
-            lane = (Q << 2) | (S << 1) | (size & 1);
+            lane = (Q << 2) | (S << 1) | ((size >> 1) & 1);  // H lane = Q:S:size<1>
         } else if (base_opcode == 4 && size == 0) {
