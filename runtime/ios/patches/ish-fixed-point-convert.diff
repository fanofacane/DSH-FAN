 static int gen_simd_fp(struct gen_state *state, uint32_t insn) {
+    // AdvSIMD floating-point <-> fixed-point, immediate #fbits. These must
+    // precede generic shift-immediate decoding. S/D only; reject reserved
+    // encodings (scalar Q=0, vector .1D, or unsupported half precision).
+    // Use the exact native immediate instruction, not integer shifts and
+    // multiply/divide: #32/#64, saturation, NaNs and directed rounding differ.
+    uint32_t fixed_class = insn & 0x8f80fc00;
+    if ((fixed_class == 0x0f00fc00 || fixed_class == 0x0f00e400) && (insn & 0x00780000) && (insn & 0x50000000) != 0x10000000) {
+        uint32_t immh = (insn >> 19) & 15;
+        uint32_t immb = (insn >> 16) & 7;
+        bool scalar = (insn >> 28) & 1;
+        bool q = (insn >> 30) & 1;
+        bool u = (insn >> 29) & 1;
+        unsigned bits = (immh & 8) ? 64 : (immh & 4) ? 32 : 0;
+        if (!bits || (scalar && !q) || (!scalar && bits == 64 && !q)) {
+            gen_interrupt(state, INT_UNDEFINED);
+            return 0;
+        }
+        unsigned fbits = 2 * bits - ((immh << 3) | immb);
+        unsigned shape = scalar ? (bits == 64 ? 4 : 3) : (bits == 64 ? 2 : q ? 1 : 0);
+        unsigned op = (fixed_class == 0x0f00e400 ? 2 : 0) + u;
+        static void (*const gadgets[4][5])(void) = {
+            {gadget_fixed_fcvtzs_2s, gadget_fixed_fcvtzs_4s, gadget_fixed_fcvtzs_2d, gadget_fixed_fcvtzs_s, gadget_fixed_fcvtzs_d},
+            {gadget_fixed_fcvtzu_2s, gadget_fixed_fcvtzu_4s, gadget_fixed_fcvtzu_2d, gadget_fixed_fcvtzu_s, gadget_fixed_fcvtzu_d},
+            {gadget_fixed_scvtf_2s, gadget_fixed_scvtf_4s, gadget_fixed_scvtf_2d, gadget_fixed_scvtf_s, gadget_fixed_scvtf_d},
+            {gadget_fixed_ucvtf_2s, gadget_fixed_ucvtf_4s, gadget_fixed_ucvtf_2d, gadget_fixed_ucvtf_s, gadget_fixed_ucvtf_d},
+        };
+        gen(state, (unsigned long)gadgets[op][shape]);
+        gen(state, (insn & 31) | (((insn >> 5) & 31) << 8) | (fbits << 16));
+        return 1;
+    }
